#!/usr/bin/env sh
set -eu

if [ -n "${FAKE_DOCKER_LOG:-}" ]; then
    printf '%s\n' "$*" >> "${FAKE_DOCKER_LOG}"
fi

case "${1:-}" in
    info)
        exit "${FAKE_DOCKER_INFO_EXIT:-0}"
        ;;
    image)
        if [ "${2:-}" = "inspect" ]; then
            exit "${FAKE_DOCKER_IMAGE_INSPECT_EXIT:-0}"
        fi
        ;;
    run)
        exit "${FAKE_DOCKER_RUN_EXIT:-0}"
        ;;
esac

exit 0
